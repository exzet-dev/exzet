FROM ubuntu:22.04 AS builder

# CORE BUILD DEPS - GROUPED BY PURPOSE
RUN apt-get update && apt-get install --no-install-recommends -y \
    # COMPILER AND BUILD TOOLS
    build-essential \
    bc \
    bison \
    flex \
    ninja-build \
    pkg-config \
    gperf \
    && rm -rf /var/lib/apt/lists/*

# DEVELOPMENT LIBRARIES
RUN apt-get update && apt-get install --no-install-recommends -y \
    libelf-dev \
    libssl-dev \
    libcap-dev \
    libmount-dev \
    libseccomp-dev \
    libblkid-dev \
    liblz4-dev \
    libzstd-dev \
    libpam0g-dev \
    libidn2-dev \
    libqrencode-dev \
    libgnutls28-dev \
    libacl1-dev \
    && rm -rf /var/lib/apt/lists/*

# PYTHON AND DOCUMENTATION TOOLS
RUN apt-get update && apt-get install --no-install-recommends -y \
    python3 \
    python3-pip \
    python3-setuptools \
    xsltproc \
    docbook-xsl \
    && rm -rf /var/lib/apt/lists/*

# SYSTEM UTILITIES
RUN apt-get update && apt-get install --no-install-recommends -y \
    busybox-static \
    musl-tools \
    cpio \
    wget \
    xz-utils \
    meson \
    acl \
    util-linux \
    kmod \
    dbus \
    file \
    && rm -rf /var/lib/apt/lists/*

# PYTHON DEPENDENCIES
RUN python3 -m pip install --no-cache-dir jinja2

# VERSIONS
ENV KERNEL_VERSION=6.1
ENV SYSTEMD_VERSION=254

WORKDIR /build
COPY bin/spawn /build/spawn
COPY docker/dependencies/* /build/
RUN chmod +x /build/build.sh

VOLUME /output

CMD ["/build/build.sh"]
